      "title": "Open the Host List menu",
      "text": "From the Host List, tap the three-dot menu in the top corner."
    },
    {
      "id": "open-settings",
      "title": "Open Settings",
      "text": "Choose Settings. This changes ConnectBot's app-wide settings, rather than the settings for an individual host."
    },
