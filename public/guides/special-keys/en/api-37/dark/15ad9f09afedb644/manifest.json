      "title": "Keep the special keys visible",
      "text": "Turn on Special keys always visible. This keeps the terminal's special-key toolbar on screen"
    },
    {
      "id": "return-to-hosts",
      "title": "Return to the Host List",
      "text": "Go back to the Host List. Your setting is saved automatically."
    },
    {
