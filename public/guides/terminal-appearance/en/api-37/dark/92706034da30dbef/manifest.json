  "transcript": [
    {
      "id": "open-menu",
      "title": "Open the Host List menu",
      "text": "From the Host List, open the three-dot menu."
    },
    {
      "id": "open-profiles",
      "title": "Open Profiles",
      "text": "Choose Profiles. Profiles let you reuse terminal appearance settings across hosts."
    },
    {
      "id": "create-profile",
      "title": "Create a profile",
      "text": "Tap the plus button and name the new profile something memorable. I'll use 'Readable' in this example."
    },
    {
      "id": "choose-colors",
      "title": "Choose a color scheme",
      "text": "Under Color Scheme, select Solarized Dark. Terminal colors are independent of the app's light or dark theme."
    },
    {
      "id": "choose-font",
      "title": "Choose a font size",
      "text": "Set Font Size to a font size that is comfortable on your screen."
    },
    {
      "id": "save-profile",
      "title": "Save the profile",
      "text": "Tap Save, then return to the Host List."
    },
    {
      "id": "assign-profile",
      "title": "Assign the profile to a host",
      "text": "Edit the host you want to customize, choose Readable under Profile, and save the host."
    },
    {
      "id": "show-result",
      "title": "Open the terminal",
      "text": "The next session for the host will use the colors and font size you chose."
    }
  ],
