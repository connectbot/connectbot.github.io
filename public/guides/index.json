        {
          "id": "enter-address",
          "title": "Enter the connection details",
          "text": "In Quick connect, enter your username, server address, and optionally port, like demo@example.com. Remember, this is only an example host, so you must replace these example details with your own. Port 22 is the usual SSH port.",
          "spoken": "In Quick connect, enter your username, server address, and optionally port. For example: demo, at, example dot com. Remember, this is only an example host, so you must replace these example details with your own. Port twenty-two is the usual SSH port."
        },
        {
          "id": "save-host",
          "title": "Save the host",
          "text": "Tap Add host to save the connection."
        },
